#!/usr/bin/env bash
# bd-tui — run the beads kanban TUI straight from a source checkout (no install).
#
# For a normal install prefer `uv tool install` / `pipx install` (see README).
# This script just bootstraps a local venv and runs the package in place.
#
#   Symlink onto PATH:  ln -sf /path/to/bd-tui/bin/bd-tui ~/.local/bin/bd-tui
#
# BEADS_DIR is left to bd's normal auto-discovery (walk up from the cwd). If your
# beads DB isn't under the cwd, export BEADS_DIR yourself before running.
set -euo pipefail

# Resolve through any PATH symlink to the real script location.
SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
PROJECT="$(cd "$(dirname "$SCRIPT")/.." && pwd)"
VENV="$PROJECT/.venv"
PY="$VENV/bin/python"

# Recreate the venv if missing.
if [[ ! -x "$PY" ]]; then
    echo "bd-tui: creating virtualenv…" >&2
    if command -v uv >/dev/null 2>&1; then
        uv venv "$VENV" >&2
        uv pip install --python "$PY" -r "$PROJECT/requirements.txt" >&2
    else
        python3 -m venv "$VENV" >&2
        "$PY" -m pip install -r "$PROJECT/requirements.txt" >&2
    fi
fi

# -P keeps the cwd off sys.path so a stray module there can't shadow the stdlib;
# PYTHONPATH still resolves the package from the checkout.
export PYTHONPATH="$PROJECT${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -P -m beads_tui "$@"
