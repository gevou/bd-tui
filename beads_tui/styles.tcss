/* beads-tui styles */

#main {
    height: 1fr;
}

#board {
    /* Alone (no drill-in): fills 100%. In drill-in the three panes split
       2fr : 2fr : 1fr  (list 40% / detail 40% / activity 20%). */
    width: 2fr;
    height: 100%;
}

#detail-pane {
    width: 2fr;
    height: 100%;
    border: round $accent;
    padding: 0 1;
}

#activity-pane {
    /* Fixed 20% width so the feed is the SAME (narrow, drill-in) size in every
       view — it must not widen when the detail pane is hidden (non-drilled).
       board + detail split the remaining 80%. */
    width: 20%;
    height: 100%;
    border: round $panel-lighten-2;
    padding: 0 1;
    margin: 0 0 0 1;
}

#activity-header { text-style: bold; color: $accent; margin: 0 0 1 0; }
#activity-list { height: 1fr; }

.activity-empty { padding: 0 1; color: $text-muted; }

.activity-item {
    /* auto height so the multi-line body wraps instead of truncating. No side
       border — messages are separated by their colored header line instead. */
    height: auto;
    margin: 0 0 1 0;
}

/* Header/meta line: a subtle background bar on EVERY message so the start of
   each is obvious (general separation, not just mentions). */
.activity-line {
    background: $boost;
    color: $text-muted;
    text-style: bold;
    padding: 0 1;
}

.activity-body { padding: 0 1; color: $text; }

/* Read @mention rows: dimmed body, accent header. */
.activity-item.mention .activity-line { color: $accent; }
.activity-item.mention .activity-body { color: $text-muted; }

/* Unread @mention rows: ● + bold body + a stronger warning header accent. */
.activity-item.mention.unread .activity-line {
    background: $warning-muted;
    color: $warning;
}
.activity-item.mention.unread .activity-body {
    color: $text;
    text-style: bold;
}

.activity-item:hover .activity-line { background: $accent 30%; }

/* Focus highlights the whole row. */
.activity-item:focus .activity-line,
.activity-item:focus .activity-body {
    background: $accent;
    color: auto;
    text-style: bold;
}

#pane-title { color: $accent; }
#pane-heading { margin: 1 0; }
#pane-labels { color: $text-muted; }
#pane-desc { margin: 1 0; color: $text-muted; }
#pane-comments-header { margin: 1 0 0 0; text-style: bold; }
#pane-comments { margin: 1 0 0 0; }

.column {
    /* Split the available width evenly across the currently-visible columns:
       1fr each => fewer columns are wider, more columns are narrower, and
       together they always fill the board's width. */
    width: 1fr;
    height: 100%;
    border: round $panel-lighten-2;
    margin: 0 1 0 0;
    padding: 0 1;
}

.card {
    /* Compact: one row per card, no border or gap between cards. */
    height: 1;
    padding: 0 1;
    margin: 0;
    color: $text;
}

.card.p0 { color: $error; }
.card.p1 { color: $warning; }
.card.p2 { color: $text; }
.card.p3 { color: $text-muted; }
.card.p4 { color: $text-disabled; }

/* Dimmed, non-interactive ancestor row in an active-status column: gives its
   nested active cards their parent context without reading as a real card. */
.card.context-row {
    color: $text-disabled;
    text-style: italic;
}

/* Focus rule comes AFTER the priority colors so it wins; `auto` picks a text
   color that contrasts with the highlight background (fixes orange-on-orange). */
.card.selected {
    background: $boost;
    text-style: bold;
}

.card:focus {
    background: $accent;
    color: auto;
    text-style: bold;
}

#search {
    dock: top;
    height: 3;
}

/* modal screens */
DetailScreen, CommentScreen {
    align: center middle;
}

#detail-box {
    width: 80%;
    max-width: 120;
    height: 80%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#detail-title { color: $accent; }
#detail-heading { margin: 1 0; }
#detail-desc { margin: 1 0; color: $text-muted; }
#detail-comments-header { margin: 1 0 0 0; text-style: bold; }

.comment {
    border: round $panel-lighten-1;
    padding: 0 1;
    margin: 1 0 0 0;
}

#confirm-box {
    width: auto;
    max-width: 80;
    height: auto;
    border: round $warning;
    background: $surface;
    padding: 1 2;
}

#confirm-message { margin: 0 0 1 0; }
#confirm-hint { color: $text-muted; }

#confirm-buttons {
    height: 3;
    align: right middle;
}

#confirm-buttons Button {
    margin: 0 0 0 2;
}

#comment-box {
    width: 70%;
    max-width: 100;
    height: 60%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

#comment-input {
    height: 1fr;
    margin: 1 0;
}

#comment-buttons {
    height: 3;
    align: right middle;
}

#comment-buttons Button {
    margin: 0 0 0 2;
}
